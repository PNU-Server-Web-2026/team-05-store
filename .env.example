# Скопіюйте цей файл у .env і за потреби змініть значення.
# Файл .env НЕ комітиться (він у .gitignore).
# Якщо змінюєте користувача/пароль/порт — оновіть і ConnectionStrings:Default
# (краще через user-secrets: dotnet user-secrets set "ConnectionStrings:Default" "...").
# Якщо змінюєте POSTGRES_USER або POSTGRES_DB — так само оновіть docker/pgadmin/servers.json.
POSTGRES_DB=online_store
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# pgAdmin (docker compose --profile tools up -d)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
